# NASA Earthdata Login. Copy to backend/.env or repository-root .env and replace locally.
NASA_EARTHDATA_USERNAME=your_username
NASA_EARTHDATA_PASSWORD=your_password
# Optional token-based Earthaccess login alternative.
# EARTHDATA_TOKEN=your_token
# Optional: required when selecting NOAA monthly station precipitation.
# NOAA_CDO_TOKEN=your_token

# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional. Defaults to backend/data and backend/data/results/investigations.sqlite3.
# EARTH_DATA_DIR=C:/path/to/earth-data

# Application settings
NODE_ENV=development
